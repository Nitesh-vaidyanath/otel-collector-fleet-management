# Build stage
FROM golang:1.21-alpine AS builder

WORKDIR /build

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY pkg/ ./pkg/

# Build standalone OpAMP server with build tag
# Builds from pkg/backend with standalone tag (includes main_standalone.go, excludes main.go)
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -tags standalone -o opamp-server ./pkg/backend

# Final stage
FROM alpine:latest

WORKDIR /app

# Install ca-certificates for TLS support
RUN apk --no-cache add ca-certificates

# Copy binary from builder
COPY --from=builder /build/opamp-server ./opamp-server

# Create directory for TLS certificates (optional)
RUN mkdir -p /app/tls

# Expose OpAMP port (default 4321) and health check port (8080)
EXPOSE 4321 8080

# Run the standalone OpAMP server
CMD ["./opamp-server"]

